# ─────────────────────────────────────────────
# Global environment variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# Your base domain (e.g. example.com)
# Services will be exposed at *.home.example.com
DOMAIN=example.com

# Subdomain prefix used for the wildcard CNAME
# Full pattern: *.${HOME_SUBDOMAIN}.${DOMAIN}
HOME_SUBDOMAIN=home

# ACME / Let's Encrypt email address
ACME_EMAIL=you@example.com

# ── Tailscale ─────────────────────────────────
# Generate at https://login.tailscale.com/admin/settings/keys
# Use a reusable, ephemeral auth key tagged with your homelab tag
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The hostname Caddy will appear as on your tailnet
# Tailscale FQDN will be: <TS_HOSTNAME>.<tailnet-name>.ts.net
TS_HOSTNAME=caddy-home

# ── Cloudflare ────────────────────────────────
# API Token — needs Zone:Read + DNS:Edit on your domain zone
# Create at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
