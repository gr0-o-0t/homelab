# Wrapper image for purplei2p/i2pd: copies i2pd.conf from the host mount at
# /config-host/ at startup and points i2pd at the live
# /config-host/tunnels.conf, so tunnel changes reload with SIGHUP instead of a
# restart. See docker-entrypoint.i2p.sh.

FROM purplei2p/i2pd:latest

USER root

# Pre-create the data directory with correct ownership so that
# Docker named volumes get initialized with the right permissions.
RUN mkdir -p /home/i2pd/data && chown -R 166:166 /home/i2pd/data

COPY docker-entrypoint.i2p.sh /docker-entrypoint.i2p.sh
RUN chmod +x /docker-entrypoint.i2p.sh

ENTRYPOINT ["/docker-entrypoint.i2p.sh"]
