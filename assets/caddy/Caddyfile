# ─────────────────────────────────────────────────────────────────────────────
# Main Caddyfile
#
# TLS strategy: wildcard certificate via Cloudflare DNS-01 challenge.
# This lets us get a single cert for *.home.<domain> without exposing
# port 80/443 to the public internet — the DNS challenge is entirely
# out-of-band.
#
# Docs:
#   https://caddyserver.com/docs/caddyfile/options
#   https://github.com/caddy-dns/cloudflare
# ─────────────────────────────────────────────────────────────────────────────
{
	# Global ACME settings
	email {$ACME_EMAIL}

	# Obtain & renew ALL certificates via Cloudflare DNS-01.
	# The `cloudflare` directive comes from the caddy-dns/cloudflare plugin
	# compiled into our custom image (see core/Dockerfile.caddy).
	acme_dns cloudflare {$CLOUDFLARE_API_TOKEN}

	# Optional: use Let's Encrypt staging while testing to avoid rate limits.
	# Comment out for production.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

	# Disable the Caddy admin API on the public interface; bind only to
	# localhost inside the container's network namespace (= Tailscale namespace)
	admin localhost:2019

	# No automatic http→https redirects. :80 is shared with the tunnels
	# (cloudflared, i2p), and the redirect for a tailnet-only site would
	# answer a tunnel client with that private hostname. Tailnet clients use
	# https:// directly; unmatched plain-HTTP hosts hit the catch-alls below.
	auto_https disable_redirects
}

# ── Wildcard TLS snippet ──────────────────────────────────────────────────────
# Declare the wildcard cert once as a named snippet. Every tailnet site block
# (*.{$HOME_SUBDOMAIN}.{$DOMAIN}) imports it. Cloudflare sites are plain HTTP:
# TLS is terminated at the Cloudflare edge.
(wildcard_tls) {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}
}

# ── Service sites ─────────────────────────────────────────────────────────────
# One file per service, caddy/sites/<name>.conf, holding the site blocks of
# every layer it is enabled on (tailnet, Cloudflare, I2P, Tor, Yggdrasil).
# Rendered by `homelab enable|disable|reload <name>` from
# services/<name>/exposure.yaml. Tor sites are http://<onion>:8081: tor's
# HiddenServicePort targets tailscale:8081, a listener that serves only onion
# vhosts, since sharing :80 would let a Tor client send the Host header of a
# cf/i2p-only site and reach it.
import /homelab/caddy/sites/*.conf

# ── Legacy per-layer directories ──────────────────────────────────────────────
# Where routes lived before caddy/sites. `homelab update` migrates them and
# leaves these empty; the imports remain so an install that has not migrated
# yet keeps routing.

# ── Private site blocks (tailnet only) ───────────────────────────────────────
# Each file handles <service>.{$HOME_SUBDOMAIN}.{$DOMAIN}.
import /homelab/caddy/conf.d/*.conf

# ── Public site blocks (Cloudflare Tunnel) ───────────────────────────────────
# Each file handles <service>.{$DOMAIN}.
# Traffic arrives via cloudflared → http://tailscale:80, TLS is terminated at Cloudflare edge.
import /homelab/caddy/conf.d-cf/*.conf

# ── I2P eepsite blocks ────────────────────────────────────────────────────────
import /homelab/caddy/conf.d-i2p/*.conf

# ── Tor onion service blocks ───────────────────────────────────────────────────
import /homelab/caddy/conf.d-tor/*.conf

# ── Yggdrasil mesh blocks ─────────────────────────────────────────────────────
import /homelab/caddy/conf.d-ygg/*.conf

# ── Catch-alls for the plain-HTTP listeners ──────────────────────────────────
# cloudflared and i2p reach Caddy on :80, tor on :8081. A Host that matches no
# site there is closed rather than answered: without these, Caddy replies with
# an empty 200, and on :80 redirects private hostnames to https, which tells a
# tunnel client the names of tailnet-only services. Specific sites above win.
http://:80 {
	abort
}

http://:8081 {
	abort
}
